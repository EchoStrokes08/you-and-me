{
  "name": "you-and-me",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "db:sql": "node --env-file=.env scripts/run-sql.mjs",
    "db:counts": "node --env-file=.env scripts/counts.mjs",
    "db:check": "node --env-file=.env scripts/db-check.mjs",
    "db:notificaciones": "node --env-file=.env scripts/config-notificaciones.mjs",
    "db:tipos": "node --env-file=.env scripts/tipos.mjs",
    "test:db": "node --env-file=.env scripts/test-db.mjs",
    "copia": "node --env-file=.env scripts/copia.mjs",
    "copia:programar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/programar-copia.ps1",
    "restaurar": "node --env-file=.env scripts/restaurar.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "aws4fetch": "1.0.20",
    "fflate": "^0.8.3",
    "framer-motion": "^14.0.0",
    "leaflet": "^1.9.4",
    "mediabunny": "1.61.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pg": "^8.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
